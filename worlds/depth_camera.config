<?xml version="1.0"?>
<window>
  <width>720</width>
  <height>580</height>
</window>
<plugin filename="ImageDisplay" name="Tractor Depth">
  <gz-gui>
    <title>Tractor Depth — distance image</title>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <topic>/tractor/camera/depth</topic>
  <topic_picker>false</topic_picker>
</plugin>
