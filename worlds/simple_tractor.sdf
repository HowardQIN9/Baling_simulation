      <joint name="loader_lift_joint" type="revolute">
        <parent>loader_mount</parent><child>loader_boom</child>
        <axis>
          <xyz>0 -1 0</xyz>
          <limit><lower>0</lower><upper>1.44</upper><effort>50000</effort><velocity>0.20</velocity></limit>
          <dynamics><damping>100</damping></dynamics>
        </axis>
      </joint>
      <joint name="attachment_tilt_joint" type="revolute">
        <parent>loader_boom</parent><child>attachment_carrier</child>
        <axis>
          <xyz>0 -1 0</xyz>
          <limit><lower>-0.65</lower><upper>0.85</upper><effort>15000</effort><velocity>0.35</velocity></limit>
          <dynamics><damping>50</damping></dynamics>
        </axis>
      </joint>
      <plugin filename="libBaleLoaderHydraulics.so" name="bale_sim::LoaderHydraulics">
        <pump_flow_lpm>86</pump_flow_lpm>
        <relief_pressure_bar>200</relief_pressure_bar>
        <command_timeout>0.5</command_timeout>
        <lift>
          <joint>loader_lift_joint</joint>
          <bore>0.070</bore><rod>0.040</rod><cylinders>2</cylinders>
          <moment_arm>0.32</moment_arm><flow_lpm>60</flow_lpm><max_speed>0.20</max_speed>
          <lower>0</lower><upper>1.44</upper>
          <p_gain>200000</p_gain><i_gain>40000</i_gain><d_gain>35000</d_gain>
        </lift>
        <tilt>
          <joint>attachment_tilt_joint</joint>
          <bore>0.050</bore><rod>0.030</rod><cylinders>2</cylinders>
          <moment_arm>0.18</moment_arm><flow_lpm>45</flow_lpm><max_speed>0.35</max_speed>
          <lower>-0.65</lower><upper>0.85</upper>
          <p_gain>30000</p_gain><i_gain>6000</i_gain><d_gain>5000</d_gain>
        </tilt>
        <grip_left>
          <joint>grip_left_joint</joint><linear>true</linear>
          <bore>0.040</bore><rod>0.025</rod><cylinders>1</cylinders>
          <moment_arm>1</moment_arm><flow_lpm>15</flow_lpm><max_speed>0.12</max_speed>
          <pressure_limit_bar>100</pressure_limit_bar>
          <lower>0</lower><upper>0.70</upper>
          <p_gain>80000</p_gain><i_gain>25000</i_gain><d_gain>4000</d_gain>
        </grip_left>
        <grip_right>
